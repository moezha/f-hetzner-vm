# --- Security & Credentials ---
# NEVER commit the actual config file with passwords/keys
config.env
.env

# --- Logs ---
# Ignore all log files generated by the setup script or the OS
*.log
/var/log/

# --- Temporary & Backup Files ---
# Ignore temporary files created by text editors like nano or vim
*~
*.swp
*.swo
*.bak
*.tmp

# --- OS Generated Files ---
# Ignore macOS/Windows folder view settings
.DS_Store
Thumbs.db

# --- IDEs & Editors ---
# Ignore local workspace settings for VS Code, IntelliJ, etc.
.vscode/
.idea/